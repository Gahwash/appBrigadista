<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="appBrigadista.Pages.ChatBrigadistasPage"
    Title="Chat brigadistas"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout
            Grid.Row="0"
            Padding="16,12"
            Spacing="10"
            BackgroundColor="White">

            <VerticalStackLayout Spacing="2">
                <Label
                    Text="Chat de brigadistas"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#212121" />

                <Label
                    Text="Mensajes grupales entre brigadistas"
                    FontSize="14"
                    TextColor="#616161" />
            </VerticalStackLayout>

            <Button
                x:Name="RegresarButton"
                Text="Regresar"
                BackgroundColor="#757575"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="38"
                MinimumWidthRequest="0"
                Padding="12,4"
                FontSize="12"
                HorizontalOptions="Start"
                Clicked="OnRegresarClicked" />

        </VerticalStackLayout>

        <CollectionView
            x:Name="MensajesCollection"
            Grid.Row="1"
            Margin="16,12"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="20"
                    Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Label
                        Text="No hay mensajes todavía."
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#424242"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Los mensajes grupales de brigadistas aparecerán aquí."
                        FontSize="14"
                        TextColor="#757575"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,10"
                        Padding="14"
                        BackgroundColor="White"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="{Binding HeaderTexto}"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#4A4A4A" />

                            <Label
                                Text="{Binding Contenido}"
                                FontSize="16"
                                TextColor="#212121"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border
            Grid.Row="2"
            Padding="12"
            BackgroundColor="White"
            Stroke="#DDDDDD"
            StrokeThickness="1">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                <Border
                    Grid.Column="0"
                    BackgroundColor="#F5F5F5"
                    Stroke="#BDBDBD"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="10,0">

                    <Entry
                        x:Name="MensajeEntry"
                        Placeholder="Escribe un mensaje..."
                        TextColor="#212121"
                        PlaceholderColor="#757575"
                        BackgroundColor="Transparent"
                        ReturnType="Send"
                        Completed="OnMensajeCompleted" />
                </Border>

                <Button
                    x:Name="EnviarButton"
                    Grid.Column="1"
                    Text="Enviar"
                    BackgroundColor="#1565C0"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="44"
                    MinimumWidthRequest="82"
                    Padding="12,0"
                    FontSize="14"
                    Clicked="OnEnviarClicked" />

            </Grid>
        </Border>

    </Grid>
</ContentPage>
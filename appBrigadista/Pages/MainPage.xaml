<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:appBrigadista.PageModels"             
             xmlns:models="clr-namespace:appBrigadista.Models"
             xmlns:controls="clr-namespace:appBrigadista.Pages.Controls"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="appBrigadista.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             x:Name="OverviewPage"
             Title="Brigadista">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="25"
            VerticalOptions="Center">

            <Label
                Text="APP BRIGADISTA"
                FontSize="32"
                HorizontalOptions="Center" />

            <Border
                BackgroundColor="LightGreen"
                StrokeThickness="0"
                Padding="10">

                <Label
                    x:Name="EstadoMqttLabel"
                    Text="Esperando conexión MQTT..."
                    TextColor="Black"
                    FontSize="18"
                    HorizontalOptions="Center" />

            </Border>

            <Label
                Text="Esperando alertas..."
                FontSize="22"
                HorizontalOptions="Center" />

            <Button
                Text="Cerrar sesión"
                Clicked="CerrarSesion_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>

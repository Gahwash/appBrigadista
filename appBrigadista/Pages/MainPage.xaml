<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:appBrigadista.PageModels"             
             xmlns:models="clr-namespace:appBrigadista.Models"
             xmlns:controls="clr-namespace:appBrigadista.Pages.Controls"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="appBrigadista.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             x:Name="OverviewPage"
             Title="Brigadista">

    <ScrollView>

        <VerticalStackLayout
            Padding="22"
            Spacing="18">

            <!-- Encabezado -->
            <Border
                BackgroundColor="White"
                Stroke="#DDDDDD"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="18">

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="App Brigadista"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#212121"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Sistema de apoyo durante emergencia"
                        FontSize="15"
                        TextColor="#616161"
                        HorizontalOptions="Center" />

                    <Button
                        Text="Chat de brigadistas"
                        BackgroundColor="#1565C0"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontAttributes="Bold"
                        Clicked="OnChatClicked" />

                </VerticalStackLayout>

            </Border>

            <!-- Estado de conexión -->
            <Border
                BackgroundColor="#F8FBFF"
                Stroke="#1565C0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="18">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Estado del nodo FOG"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#1565C0" />

                    <Label
                        x:Name="EstadoMqttLabel"
                        Text="Conectando con el nodo FOG..."
                        FontSize="17"
                        TextColor="#212121" />

                    

                </VerticalStackLayout>

            </Border>

            <!-- Estado de espera -->
            <Border
                BackgroundColor="White"
                Stroke="#DDDDDD"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                Padding="18">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Modo de operación"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#212121" />

                    <Label
                        Text="Esperando alerta"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#2E7D32" />

                    <Label
                        Text="Cuando se publique una alerta, se abrirá automáticamente la pantalla de emergencia."
                        FontSize="14"
                        TextColor="#616161" />

                </VerticalStackLayout>

            </Border>

            <!-- Sesión -->
            <Button
                Text="Cerrar sesión"
                BackgroundColor="#C62828"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="48"
                FontAttributes="Bold"
                Clicked="CerrarSesion_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
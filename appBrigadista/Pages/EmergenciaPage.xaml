<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="appBrigadista.Pages.EmergenciaPage"
    Title="Emergencia"
    BackgroundColor="White">

    <Grid>

        <!-- Botón del croquis -->
        <Button
            Text="🗺"
            FontSize="22"
            WidthRequest="50"
            HeightRequest="50"
            CornerRadius="25"
            BackgroundColor="#0D47A1"
            TextColor="White"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="15"
            Clicked="OnVerCroquisClicked"/>

        <ScrollView Margin="0,60,0,0">

            <VerticalStackLayout
                Padding="20"
                Spacing="20">

                <!-- Emergencia -->
                <Border
                    BackgroundColor="#C62828"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">

                    <Label
                        Text="⚠ EMERGENCIA ACTIVA"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"/>

                </Border>

                <Border
                    Stroke="#DDDDDD"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            x:Name="TipoLabel"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#212121"/>

                        <Label
                            x:Name="SeveridadLabel"
                            FontSize="18"
                            TextColor="#424242"/>

                        <Label
                            x:Name="MensajeLabel"
                            FontSize="17"
                            TextColor="#424242"/>

                    </VerticalStackLayout>

                </Border>

                <Label
                    Text="Pase de lista"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#212121"/>

                <CollectionView
                    x:Name="PaseListaCollection">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,0,0,15"
                                Stroke="#DDDDDD"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="White"
                                Padding="15">

                                <VerticalStackLayout
                                    Spacing="10">

                                    <Label
                                        Text="{Binding Nombre}"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                        TextColor="#212121"/>

                                    <Label
                                        Text="{Binding Matricula}"
                                        TextColor="#616161"/>

                                    <Label
                                        Text="{Binding Estado}"
                                        FontAttributes="Bold"
                                        TextColor="#1565C0"/>

                                    <HorizontalStackLayout
                                        Spacing="8">

                                        <Button
                                            Text="Seguro"
                                            BackgroundColor="#2E7D32"
                                            TextColor="White"
                                            Clicked="OnSeguroClicked"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Text="Ausente"
                                            BackgroundColor="#EF6C00"
                                            TextColor="White"
                                            Clicked="OnAusenteClicked"
                                            CommandParameter="{Binding .}" />

                                        <Button
                                            Text="Ver ubicación"
                                            BackgroundColor="#1565C0"
                                            TextColor="White"
                                            Clicked="OnVerUbicacionClicked"
                                            CommandParameter="{Binding .}" />

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- Ubicación -->
                <Frame
                    x:Name="UbicacionFrame"
                    IsVisible="False"
                    BorderColor="#1565C0"
                    BackgroundColor="White"
                    CornerRadius="10"
                    Padding="16">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="📍 Ubicación actual"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#1565C0"/>

                        <Label
                            x:Name="VictimaUbicacionLabel"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#212121"/>

                        <Label
                            x:Name="ZonaNombreLabel"
                            FontSize="18"
                            TextColor="#212121"/>

                        <Label
                            x:Name="PisoLabel"
                            FontSize="16"
                            TextColor="#424242"/>

                        <Label
                            x:Name="ConfianzaLabel"
                            FontSize="14"
                            TextColor="#616161"/>

                        <Label
                            x:Name="UltimaActualizacionLabel"
                            FontSize="13"
                            TextColor="#757575"/>

                    </VerticalStackLayout>

                </Frame>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
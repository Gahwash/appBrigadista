<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="appBrigadista.Pages.EmergenciaPage"
    Title="Emergencia">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Border
                BackgroundColor="Red"
                StrokeThickness="0"
                Padding="15">

                <Label
                    Text="⚠️ EMERGENCIA ACTIVA"
                    FontSize="28"
                    TextColor="White"
                    HorizontalOptions="Center" />

            </Border>

            <Label
                x:Name="TipoLabel"
                FontSize="20" />

            <Label
                x:Name="SeveridadLabel"
                FontSize="20" />

            <Label
                x:Name="MensajeLabel"
                FontSize="20" />

            <Label
                Text="PASE DE LISTA"
                FontSize="24"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="PaseListaCollection">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,15"
                            Padding="15">

                            <VerticalStackLayout
                                Spacing="10">

                                <Label
                                    Text="{Binding Nombre}"
                                    FontSize="20"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Matricula}" />

                                <Label
                                    Text="{Binding Estado}" />

                                <HorizontalStackLayout
                                    Spacing="10">

                                    <Button
                                        Text="Seguro"
                                        Clicked="OnSeguroClicked"
                                        CommandParameter="{Binding .}" />

                                    <Button
                                        Text="Ausente"
                                        Clicked="OnAusenteClicked"
                                        CommandParameter="{Binding .}" />

                                    <Button
                                        Text="Ver ubicación"
                                        Clicked="OnVerUbicacionClicked"
                                        CommandParameter="{Binding .}" />   

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>
            <Frame
                x:Name="UbicacionFrame"
                IsVisible="False"
                BorderColor="#028090"
                CornerRadius="8"
                Padding="16"
                Margin="0,10,0,0">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="📍 Ubicación actual"
                        FontSize="13"
                        TextColor="#5A7A85" />

                    <Label
                        x:Name="VictimaUbicacionLabel"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#0D2137" />

                    <Label
                        x:Name="ZonaNombreLabel"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#0D2137" />

                    <Label
                        x:Name="PisoLabel"
                        FontSize="14"
                        TextColor="#028090" />

                    <Label
                        x:Name="ConfianzaLabel"
                        FontSize="12"
                        TextColor="#5A7A85" />

                    <Label
                        x:Name="UltimaActualizacionLabel"
                        FontSize="11"
                        TextColor="#5A7A85" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>